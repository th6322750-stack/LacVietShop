# Kết nối API nhà cung cấp (thatim.vn API v2).
# Chép tệp này thành .env.local rồi điền giá trị thật. KHÔNG commit .env.local.

THATIM_API_URL=https://thatim.vn/api/v2

# Khoá API — lấy trong trang tài khoản của nhà cung cấp.
# Bỏ trống thì hệ thống chạy bằng bảng giá dự phòng tĩnh.
THATIM_API_KEY=

# API trả giá theo USD cho 1.000 tương tác. Tỷ giá 26000 đã đối chiếu khớp
# từng đồng với bảng giá công bố của nhà cung cấp.
THATIM_USD_TO_VND=26000

# Hệ số bán ra so với giá gốc. 1 = bán đúng giá gốc, 1.2 = cộng 20%.
THATIM_MARKUP=1

# Đẩy đơn thật là TIÊU TIỀN THẬT. Mặc định tắt; đặt true khi đã sẵn sàng.
THATIM_ALLOW_ORDERS=false

# Thời gian nhớ tạm danh mục dịch vụ (giây).
THATIM_CACHE_SECONDS=300

# Gửi thư (đặt lại mật khẩu). Bỏ trống thì mã được in ra cửa sổ chạy máy chủ
# để vẫn kiểm thử được luồng.
# Gmail: bật xác minh 2 bước rồi tạo App Password tại
# https://myaccount.google.com/apppasswords — dán vào SMTP_PASS, KHÔNG dùng
# mật khẩu đăng nhập Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
